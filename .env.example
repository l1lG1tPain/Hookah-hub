# --- Фронтенд (публичные, попадают в бандл) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Только для Netlify-функций (секреты, задаются в Netlify → Site settings → Environment) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=my_hookahhub_bot
# Необязательно: секрет вебхука (setWebhook ... &secret_token=...)
TG_WEBHOOK_SECRET=

# --- Пуш-уведомления (Web Push, VAPID) ---
# Ключи: npx web-push generate-vapid-keys
# Публичный ключ нужен и фронту (VITE_), и функциям; приватный — только функциям (секрет!)
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Адрес сайта для ссылок в уведомлениях (по умолчанию https://hookahhub.netlify.app)
SITE_URL=https://hookahhub.netlify.app
